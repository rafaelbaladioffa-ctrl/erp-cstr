DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# O superusuario e criado automaticamente apenas se estas 3 variaveis existirem.
DJANGO_SUPERUSER_EMAIL=admin@empresa.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=altere-esta-senha

# Envio de e-mail via Gmail (SMTP com senha de app)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=troque-pela-senha-de-app-do-gmail
DEFAULT_FROM_EMAIL=seu-email@gmail.com

# Origens permitidas para o frontend (React) acessar a API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# URL da API que o frontend (container) deve usar
FRONTEND_API_URL=http://localhost:8000/api

